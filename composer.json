            "homepage": "https://pavelskrbel.cz",
            "role": "Developer"
        }
    ],
    "require": {
        "saloonphp/saloon": "^4.0",
        "saloonphp/pagination-plugin": "^2.0",
        "nesbot/carbon": "^3.14"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.1",
        "laravel/pint": "^1.18"
