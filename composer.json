    "keywords": [
        "upgates",
        "php",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/codetivsro/upgates-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Pavel Skrbel",
